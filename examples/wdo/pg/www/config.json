{
  "sets": {
    "language":   "EN",
    "dateformat": "yyyy-mm-dd",
    "decimals":   2,
    "deleted":    false
  },
  "dbf": {
    "rddname": "DBFCDX"
  },
  "databases": {
    "pg": {
      "driver":            "pg",
      "host":              "127.0.0.1",
      "user":              "postgres",
      "pwd":               "postgres",
      "db":                "postgres",
      "port":              5432,
      "pool_size":         5,
      "timeout_ms":        5000,
      "ping":              true,
      "sslmode":           "disable",
      "application_name":  "hix-wdo-example",
      "client_encoding":   "UTF8",
      "berror":            "WdoErrorHandler"
    }
  }
}
