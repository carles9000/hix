# ============================================================
# hix_app.hbp — Example HIX Web Server
# ============================================================

-n
-w1
-es2
-inc
-head=full
-mt
-isrc/include
-workdir=.hbmk/${hb_compiler}/app

-static
-hbexe
-ohix

# Main Test 
src/app.prg

# Resources file
{win&msvc64}hix.res
{win&mingw64}hix.rc

# Libs
-L../..
-lhix_server

../../hix_server.hbx

# OpenSSL
hbssl.hbc

# Curl (optional, enable if libcurl dev package is installed)
hbcurl.hbc

# PDF
hbhpdf.hbc

# Harbour extensions
{win}-lhbwin
-lxhb
-lhbct
-lz
-lm

{msvc64}-ldflag=/NODEFAULTLIB:libucrt
{msvc64}-ldflag=/NODEFAULTLIB:msvcrt
{msvc64}-lucrt
