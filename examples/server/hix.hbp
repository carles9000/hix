# ============================================================
# hix.hbp — Example HIX Web Server
# ============================================================

-n
-w1
-es2
-inc
-head=full
-mt
-workdir=.hbmk/${hb_compiler}/app

-hbexe
-ohix

# Main
src/app.prg

# Resources file
{msvc64}hix.res
{mingw64}hix.rc


{win}${hix}\hix_server.hbx
{win}c:\harbour\include\harbour.hbx
{win}c:\harbour\contrib\hbcurl\hbcurl.hbx
{win}c:\harbour\contrib\hbhpdf\hbhpdf.hbx

{unix}${hix}/hix_server.hbx
{unix}${hb_inc}/harbour.hbx
{unix}${hb_root}/contrib/hbcurl/hbcurl.hbx
{unix}${hb_root}/contrib/hbhpdf/hbhpdf.hbx

${hix}/hix_server.hbc
