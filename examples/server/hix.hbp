# ============================================================
# hix_app.hbp — Example HIX Web Server
# ============================================================

-n
-w1
-es2
-inc
-head=full
-mt
-isrc/include
-workdir=.hbmk/${hb_compiler}/app

-hbexe
-ohix

# Main Test 
src/app.prg

# Resources file
{msvc64}hix.res
{mingw64}hix.rc

# Libs
-L${hix}
-lhix_server

${hix}\hix_server.hbx
c:\harbour\include\harbour.hbx

# OpensSSL
-lhbssl
-lhbssls
{msvc64}-llibcrypto-4-x64
{msvc64}-llibssl-4-x64
{mingw64}-ldflag=-l:libcrypto-4-x64.dll
{mingw64}-ldflag=-l:libssl-4-x64.dll


# Curl
{msvc64}-lhbcurl
{msvc64}-llibcurl-x64
{mingw64}-lhbcurl
{mingw64}-ldflag=-l:libcurl-x64.dll

# PDF
{msvc64}hbhpdf.hbc
{mingw64}-lhbhpdf
{mingw64}-llibhpdf
{mingw64}-lpng

# WAPI_OutputDebugString()
-lhbwin
-lxhb
-lhbct

{msvc64}-ldflag=/NODEFAULTLIB:libucrt
{msvc64}-ldflag=/NODEFAULTLIB:msvcrt
{msvc64}-lucrt
