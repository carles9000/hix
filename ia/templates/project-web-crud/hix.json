/* ----------------------------------------------
 | hix.json -- HIX Web Server Configuration
 | Project: {{PROJECT_NAME}}
 * ---------------------------------------------- */
{
  "server":
  {
    "host": "localhost",
    "port": 80,
    "maxconn": 1024,
    "timeout": 30,
    "name": "{{PROJECT_NAME}}",
    "mode": "standalone",
    "trusted_proxies": "127.0.0.1 ::1",
    "allowed_hosts": "",
    "ssl": false,
    "cert_private": "",
    "cert_public": "",
    "gzip": true,
    "gzip_min_size": 2048,
    "autostart": true,
    "exec_timeout_ms": 30000
  },
  "paths":
  {
    "root": "www",
    "log": ".logs",
    "tmp": "tmp",
    "errors": ".logs",
    "session": ".sessions",
    "certs": "certs"
  },
  "app":
  {
    "errorsys": "",
    "default_page": "index.html",
    "dispatch_mode": "full",
    "auto_close_dbf": true,
    "auto_close_dbf_log": false,
    "env": "dev",
    "debug": false
  },
  "pool_http":
  {
    "workers": 32,
    "queue_size": 256,
    "read_timeout_ms": 2000,
    "keep_alive": true,
    "keep_alive_max": 100
  },
  "session":
  {
    "storage": "memory",
    "prefix": "sess_",
    "crypt": false,
    "seed": "",
    "lifetime": 60,
    "gc_days": 3
  },
  "log":
  {
    "file": "hix.log",
    "level": "info",
    "console": true,
    "max_size_mb": 10,
    "max_files": 0
  },
  "access_log":
  {
    "enabled": true,
    "file": "access.log"
  },
  "hixstyle":
  {
    "enabled": true,
    "cache_disk": true,
    "trace": false,
    "cache_ram": false
  }
}
