# test_wdo_pg.hbp

-n
-w1
-es2
-inc
-head=full
-mt
-i../../../src/include
-i../../../src/wdo/include
-workdir=.hbmk/${hb_compiler}

-hbexe
-otest_wdo_pg

test_wdo_pg.prg

-L../../../lib/${hb_compiler}
-lhix_server

# Contrib
{unix}hbssl.hbc
{win}../../../hix_server.hbx
{win}c:\harbour\include\harbour.hbx

# OpenSSL
-lhbssl
{win}-lhbssls
{msvc64}-llibcrypto-4-x64
{msvc64}-llibssl-4-x64
{mingw64}-ldflag=-l:libcrypto-4-x64.dll
{mingw64}-ldflag=-l:libssl-4-x64.dll
{unix}-lssl
{unix}-lcrypto

# Curl
{msvc64}-lhbcurl
{msvc64}-llibcurl-x64
{mingw64}-lhbcurl
{mingw64}-ldflag=-l:libcurl-x64.dll
{unix}hbcurl.hbc

# PDF
{msvc64}hbhpdf.hbc
{mingw64}-lhbhpdf
{mingw64}-llibhpdf
{mingw64}-lpng
{unix}hbhpdf.hbc

# WAPI + xhb + hbct
{win}-lhbwin
-lxhb
-lhbct

{msvc64}-ldflag=/NODEFAULTLIB:libucrt
{msvc64}-ldflag=/NODEFAULTLIB:msvcrt
{msvc64}-lucrt
